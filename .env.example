PORT=4000
DATABASE_URL=postgres://user:password@localhost:5432/cinewrite
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
ANTHROPIC_API_KEY=your_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional — enables real semantic embeddings (Anthropic recommends Voyage AI
# since Claude does not serve embeddings directly). Without this, search
# still works using a local deterministic fallback embedding.
VOYAGE_API_KEY=

# Optional — enables the Research Lab endpoints (spec section 17/18).
TMDB_API_KEY=
OMDB_API_KEY=
